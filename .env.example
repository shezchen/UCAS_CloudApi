# Copy this file to .env before starting the stack:
#
#   cp .env.example .env
#   sed -i "s/^DB_PASSWORD=.*/DB_PASSWORD=$(openssl rand -hex 24)/" .env
#
# docker-compose.yml has no fallback for these values and refuses to start
# while they are empty, so the stack can never come up on a shared password.
# .env is git-ignored; only this example file is tracked.

# Password for the bundled PostgreSQL service, used both to initialise the
# database and to build AXONHUB_DB_DSN.
#
# PostgreSQL only reads POSTGRES_PASSWORD while creating a new data directory.
# On an existing deployment, changing this value alone leaves the database
# rejecting the connection -- see "Upgrading an existing deployment" in
# docs/en/deployment/docker.md.
#
# URL-encode the value if it contains @ / : # or ?, because it is embedded in
# the DSN.
DB_PASSWORD=

# Only needed when the commented-out MySQL services in docker-compose.yml are
# used instead of PostgreSQL.
# MYSQL_ROOT_PASSWORD=
# MYSQL_PASSWORD=
